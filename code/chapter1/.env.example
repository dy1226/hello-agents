# ============================================================================
# Chapter 1 - 第一个 Agent 环境配置文件
# ============================================================================
# 使用说明：
# 1. 复制此文件为 .env
# 2. 填入你的 API 密钥
# 3. 运行 python FirstAgentTest.py

# ============================================================================
# 🤖 LLM API 配置（必需）
# ============================================================================
# 选择以下任意一种服务，取消注释并填入对应的配置

# --- 选项 1: Deepseek（推荐，性价比高）---
API_KEY=sk-144e08550f9f40e1a559178f5c9248a9
BASE_URL=https://api.deepseek.com
MODEL_ID=deepseek-v4-flash

# --- 选项 2: 通义千问（阿里云）---
# API_KEY=sk-xxxxxxxxxxxxxx
# BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# MODEL_ID=qwen-turbo

# --- 选项 3: Moonshot（月之暗面）---
# API_KEY=sk-xxxxxxxxxxxxxx
# BASE_URL=https://api.moonshot.cn/v1
# MODEL_ID=moonshot-v1-8k

# --- 选项 4: OpenAI（需要科学上网）---
# API_KEY=sk-xxxxxxxxxxxxxx
# BASE_URL=https://api.openai.com/v1
# MODEL_ID=gpt-4o-mini

# --- 选项 5: 其他兼容 OpenAI 格式的服务 ---
# API_KEY=your_api_key_here
# BASE_URL=your_base_url_here
# MODEL_ID=your_model_id_here

# ============================================================================
# 🔍 Tavily 搜索 API（可选，用于景点推荐）
# ============================================================================
# 获取 API Key：https://tavily.com/（免费注册）
# 如果没有 Tavily Key，景点推荐功能将无法使用

TAVILY_API_KEY=your_tavily_key_here

# ============================================================================
# 💡 快速开始示例
# ============================================================================
# 如果你使用 Deepseek，配置如下：
# 
# API_KEY=sk-abc123...
# BASE_URL=https://api.deepseek.com/v1
# MODEL_ID=deepseek-chat
# TAVILY_API_KEY=tvly-xyz789...
#
# 然后运行：python FirstAgentTest.py
